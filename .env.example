# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/aquasense
DB_USER=aquasense
DB_PASSWORD=cambia-esta-clave
# Minimo 32 caracteres aleatorios. Ejemplo para generarla: openssl rand -base64 48
JWT_SECRET=
# Correo que obtendra el rol ADMIN al registrarse (opcional)
ADMIN_EMAIL=
# Intentos por minuto en registro, inicio de sesion y recuperacion
RATE_LIMIT_PER_MINUTE=10
# Origenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Correo para recuperar contrasena. Opcion 1 (recomendada): API de Mailjet por HTTPS (gratis hasta 200 correos/dia).
# MAIL_FROM debe ser un remitente validado en Mailjet.
MAIL_PROVIDER=auto
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Alternativa: API de Brevo
BREVO_API_KEY=
MAIL_SENDER_NAME=AquaSense AI
# Opcion 2: SMTP (si el servidor permite el puerto 587). Sin ningun canal, la recuperacion no esta disponible.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tudominio.com
# SOLO DESARROLLO: sin SMTP, escribe el enlace de recuperacion en el log. En produccion dejalo en false:
# sin SMTP la recuperacion responde que no esta disponible y el enlace nunca queda en los registros.
MAIL_LOG_RESET_LINKS=false
FRONTEND_RESET_URL=http://localhost:5500/#/reset-password
# IA generativa (opcional, planes gratuitos). Cadena de respaldo: Gemini -> Gemini Lite -> Groq -> Claude -> reglas.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Modelo de Groq con vision (respaldo para leer fotos)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_DAILY_QUOTA_FREE=20
# Claude (de pago, opcional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
