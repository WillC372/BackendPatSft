# Copy this file as .env and fill in the values. Never commit the .env file to the repository.
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/aquasense
DB_USER=aquasense
DB_PASSWORD=change-this-password
# At least 32 random characters. Example to generate it: openssl rand -base64 48
JWT_SECRET=
# Email of the main administrator (optional). The ADMIN role is activated from a link sent to this address.
ADMIN_EMAIL=
# Attempts per minute for registration, login and password recovery
RATE_LIMIT_PER_MINUTE=10
# Allowed origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Email for password recovery. Option 1 (recommended): Mailjet API over HTTPS (free up to 200 emails per day).
# MAIL_FROM must be a sender validated in Mailjet.
MAIL_PROVIDER=auto
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Alternative: Brevo API
BREVO_API_KEY=
MAIL_SENDER_NAME=AquaSense AI
# Option 2: SMTP (if the server allows port 587). Without any channel, password recovery is not available.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
# DEVELOPMENT ONLY: without an email channel, writes the recovery link to the log. Keep it false in production:
# without a channel, recovery responds that it is not available and the link never ends up in the logs.
MAIL_LOG_RESET_LINKS=false
FRONTEND_RESET_URL=http://localhost:5500/#/reset-password
# Generative AI (optional, free plans). Fallback chain: Gemini -> Gemini Lite -> Groq -> Claude -> rules.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq model with vision (fallback for reading photos)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_DAILY_QUOTA_FREE=20
# Claude (paid, optional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
