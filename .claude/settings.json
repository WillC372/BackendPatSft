{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "java \"$CLAUDE_PROJECT_DIR/.claude/hooks/ProtegerMain.java\"" }
        ]
      }
    ]
  }
}
